  "title": "336/2019 Sb., Nařízení vlády, kterým se stanoví stupnice základních tarifů pro příslušníky bezpečnostních sborů",
  "title_en": "",
  "short_name": "336/2019 Sb.",
  "status": "in_force",
  "issued_date": "2019-12-17",
