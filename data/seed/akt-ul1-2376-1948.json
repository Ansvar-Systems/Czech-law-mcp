síčních srážek na pojistné nemocenského pojištění (2%) u veřejných zaměstnanců, kteří mají zaručeny normální pensijní nároky, a u příjemců odpočivných (zaopatřovacích) platů z veřejného pensijního zaopatření.\nPři vyměř.\nzákladuSrážkaPři vyměř.\nzákladuSrážkaPři vyměř.\nzákladuSrážka\nnaddonaddonaddo\nKčsKčsKčsKčsKčsKčsKčsKčsKčs\n751337534256867256775135\n751252342534756967756825136\n1251753347535257068256875137\n1752254352535757168756925138\n2252755357536257269256975139\n2753256362536757369757025140\n3253757367537257470257075141\n3754258372537757570757125142\n4254759377538257671257175143\n47552510382538757771757225144\n52557511387539257872257275145\n57562512392539757972757325146\n62567513397540258073257375147\n67572514402540758173757425148\n72577515407541258274257475149\n77582516412541758374757525150\n82587517417542258475257575151\n87592518422542758575757625152\n92597519427543258676257675153\n975102520432543758776757725154\n1025107521437544258877257775155\n1075112522442544758977757825156\n1125117523447545259078257875157\n1175122524452545759178757925158\n1225127525457546259279257975159\n1275132526462546759379758025160\n1325137527467547259480258075161\n1375142528472547759580758125162\n1425147529477548259681258175163\n1475152530482548759781758225164\n1525157531487549259882258275165\n1575162532492549759982758325166\n16251675334975502510083258375167\n16751725345025507510183758425168\n17251775355075512510284258475169\n17751825365125517510384758525170\n18251875375175522510485258575171\n18751925385225527510585758625172\n19251975395275532510686258675173\n19752025405325537510786758725174\n20252075415375542510887258775175\n20752125425425547510987758825176\n21252175435475552511088258875177\n21752225445525557511188758925178\n22252275455575562511289258975179\n22752325465625567511389759025180\n23252375475675572511490259075181\n23752425485725577511590759125182\n24252475495775582511691259175183\n74752525505825587511791759225184\n25252575515875592511892259275185\n257526255259255975