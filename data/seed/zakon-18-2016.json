  "title": "18/2016 Sb., Vyhláška o vyhlášení Národní přírodní památky Kaňkovy hory a stanovení jejích bližších ochranných podmínek",
  "title_en": "",
  "short_name": "18/2016 Sb.",
  "status": "in_force",
  "issued_date": "2016-01-25",
