  "title": "421/2021 Sb., Nařízení vlády, kterým se stanoví stupnice základních tarifů pro příslušníky bezpečnostních sborů",
  "title_en": "",
  "short_name": "421/2021 Sb.",
  "status": "in_force",
  "issued_date": "2021-11-23",
