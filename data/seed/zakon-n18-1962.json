    {
      "provision_ref": "Bod 1",
      "section": "1",
      "title": "Bod 1",
      "content": "1. chráněnou oblast Pražského hradu (v rozsahu vymezeném podle § 3 vládního nařízení č. 55/1954 Sb.) i s archeologickými nálezy,"
    },
    {
      "provision_ref": "Bod 2",
      "section": "2",
      "title": "Bod 2",
      "content": "2. české korunovační klenoty,"
    },
    {
      "provision_ref": "Bod 3",
      "section": "3",
      "title": "Bod 3",
      "content": "3. horu Říp s rotundou sv. Jiří,"
    },
    {
      "provision_ref": "Bod 4",
      "section": "4",
      "title": "Bod 4",
      "content": "4. pole s pomníkem Přemysla Oráče ve Stadicích,"
    },
    {
