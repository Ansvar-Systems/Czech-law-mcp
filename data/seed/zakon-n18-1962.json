    {
      "provision_ref": "Bod 8",
      "section": "8",
      "title": "Bod 8",
      "content": "8. hrad Přimdu,"
    },
    {
      "provision_ref": "Bod 9",
      "section": "9",
      "title": "Bod 9",
      "content": "9. Přemyslovský palác v Olomouci,"
