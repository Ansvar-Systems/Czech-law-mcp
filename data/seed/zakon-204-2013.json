  "title": "204/2013 Sb., Vyhláška o vyhlášení Národní přírodní památky Rendez-vous a stanovení jejích bližších ochranných podmínek",
  "title_en": "",
  "short_name": "204/2013 Sb.",
  "status": "in_force",
  "issued_date": "2013-07-23",
