  "title": "337/2007 Sb., Nařízení vlády, kterým se stanoví stupnice základních tarifů pro příslušníky bezpečnostních sborů na rok 2008",
  "title_en": "",
  "short_name": "337/2007 Sb.",
  "status": "in_force",
