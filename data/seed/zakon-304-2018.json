  "title": "304/2018 Sb., Nařízení vlády, kterým se stanoví stupnice základních tarifů pro příslušníky bezpečnostních sborů",
  "title_en": "",
  "short_name": "304/2018 Sb.",
  "status": "in_force",
  "issued_date": "2018-12-20",
