  "title": "227/2014 Sb., Nařízení vlády, kterým se stanoví stupnice základních tarifů pro příslušníky bezpečnostních sborů pro rok 2015",
  "title_en": "",
  "short_name": "227/2014 Sb.",
  "status": "in_force",
  "issued_date": "2014-10-23",
