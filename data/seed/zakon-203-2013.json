  "title": "203/2013 Sb., Vyhláška o vyhlášení Národní přírodní rezervace Žofinka a stanovení jejích bližších ochranných podmínek",
  "title_en": "",
  "short_name": "203/2013 Sb.",
  "status": "in_force",
  "issued_date": "2013-07-23",
