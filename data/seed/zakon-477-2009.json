  "provisions": [
    {
      "provision_ref": "§ 1",
      "section": "1",
      "title": "§ 1",
      "content": "Stupnice základních tarifů pro příslušníky bezpečnostních sborů pro rok 2010 je uvedena v příloze č. 1 k tomuto nařízení."
    },
    {
      "provision_ref": "§ 2",
      "section": "2",
      "title": "§ 2",
      "content": "Stupnice základních tarifů pro příslušníky bezpečnostních sborů pro rok 2010 zvýšená o 10 % podle § 114 odst. 2 zákona je uvedena v příloze č. 2 k tomuto nařízení."
    },
    {
      "provision_ref": "§ 3",
      "section": "3",
      "title": "§ 3 Zrušovací ustanovení",
      "content": "Nařízení vlády č. 125/2009 Sb., kterým se stanoví stupnice základních tarifů pro příslušníky bezpečnostních sborů na rok 2009, se zrušuje."
    },
